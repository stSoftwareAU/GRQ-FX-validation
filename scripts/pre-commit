#!/bin/bash

# Check if docs files are being committed
if git diff --cached --name-only | grep -E "^docs/" > /dev/null; then
    echo "Docs files detected in commit. Auto-incrementing version..."
    
    # Read current version from index.js
    CURRENT_VERSION=$(grep -o 'const VERSION = "[^"]*"' docs/index.js | cut -d'"' -f2)
    echo "Current version: $CURRENT_VERSION"
    
    # Parse version components
    IFS='.' read -r major minor patch <<< "$CURRENT_VERSION"
    
    # Increment patch version
    NEW_PATCH=$((patch + 1))
    NEW_VERSION="$major.$minor.$NEW_PATCH"
    echo "New version: $NEW_VERSION"
    
    # Update version in all files (macOS/BSD sed compatible)
    echo "Updating version numbers in all files..."
    
    # Update index.js
    sed -i '' "s/const VERSION = \"[^\"]*\"/const VERSION = \"$NEW_VERSION\"/" docs/index.js
    
    # Update index.html - CSS link
    sed -i '' "s/styles\.css?v=[^\"]*/styles.css?v=$NEW_VERSION/" docs/index.html
    
    # Update index.html - version display
    sed -i '' "s/v<span id=\"version\">[^<]*<\/span>/v<span id=\"version\">$NEW_VERSION<\/span>/" docs/index.html
    
    # Update index.html - JS link
    sed -i '' "s/index\.js?v=[^\"]*/index.js?v=$NEW_VERSION/" docs/index.html
    
    # Update index.html - service worker registration
    sed -i '' "s/sw\.js?v=[^\"]*/sw.js?v=$NEW_VERSION/" docs/index.html
    
    # Update sw.js - comment and cache names
    sed -i '' "s/Version [0-9]*\.[0-9]*\.[0-9]*/Version $NEW_VERSION/" docs/sw.js
    sed -i '' "s/grq-fx-v[0-9]*\.[0-9]*\.[0-9]*/grq-fx-v$NEW_VERSION/g" docs/sw.js
    
    # Add all updated files to the commit
    git add docs/index.js docs/index.html docs/sw.js
    
    echo "Version auto-incremented to $NEW_VERSION in all files (index.js, index.html, sw.js)"
fi 