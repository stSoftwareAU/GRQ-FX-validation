{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --watch server.ts",
    "test": "deno test --allow-net --allow-read",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check **/*.ts",
    "build": "deno run --allow-read --allow-write build.ts"
  },
  "imports": {
    "fx-validator": "./src/fx-validator.ts",
    "fx-list": "./src/fx-list.ts",
    "utils": "./src/utils.ts"
  },
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["src/", "tests/", "docs/"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
} 